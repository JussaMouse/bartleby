# ============================================
# Bartleby Configuration (Minimal Bootstrap)
# ============================================
#
# This file contains only the essential settings needed to start Bartleby.
# Most other settings live in settings.yaml + secrets.yaml.
#
# First-time users: Run Bartleby and follow the interactive setup wizard.

# --- LLM (Required to Boot) ---
# Single URL for all tiers (router, fast, thinking)
LLM_URL=http://localhost:11434/v1

# Optional: API key for authentication
# LLM_API_KEY=

# --- Embeddings (Optional) ---
# If not set, uses LLM_URL
# EMBEDDINGS_URL=http://localhost:11434/v1
# EMBEDDINGS_API_KEY=

# --- Storage Paths ---
# Where Bartleby stores its data
DATABASE_PATH=./database
GARDEN_PATH=./garden
SHED_PATH=./shed
LOG_DIR=./logs

# Optional: Inbox directory for file imports
# BARTLEBY_INBOX_PATH=./inbox

# --- Logging ---
# Levels: debug, info, warn, error
LOG_LEVEL=info

# Optional: Disable console logging
# LOG_CONSOLE=false

# Optional: Show LLM reasoning (verbose)
# LOG_LLM_VERBOSE=true

# ============================================
# All Other Settings
# ============================================
#
# The following settings live in settings.yaml + secrets.yaml:
#
# - LLM models and timeouts (router, fast, thinking)
# - Calendar settings (timezone, format, reminders)
# - Presence settings (startup, scheduled, contextual)
# - Scheduler settings (check interval, missed reminders)
# - Weather integration (city, API key)
# - Signal notifications (enabled, CLI path, numbers)
# - OCR settings (enabled, URL, model)
#
# To configure these settings:
#   1. First run: Follow the interactive wizard
#   2. After setup: Use "settings" command to view/edit
#   3. Or edit settings.yaml + secrets.yaml directly
