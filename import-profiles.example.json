{
  "profiles": [
    {
      "name": "work-documents",
      "description": "Confidential work documents with OCR",
      "defaultProject": "+work",
      "defaultContext": "@office",
      "defaultPrivacy": "confidential",
      "enableOcr": true,
      "autoConfirm": false,
      "duplicateAction": "skip",
      "rulesEnabled": true
    },
    {
      "name": "personal-photos",
      "description": "Batch import personal photos without OCR",
      "defaultProject": "+memories",
      "defaultPrivacy": "private",
      "enableOcr": false,
      "autoConfirm": true,
      "duplicateAction": "skip",
      "rulesEnabled": false
    },
    {
      "name": "receipts",
      "description": "Financial receipts with OCR and strict duplicate checking",
      "defaultProject": "+finances",
      "defaultContext": "@admin",
      "defaultPrivacy": "private",
      "enableOcr": true,
      "autoConfirm": false,
      "duplicateAction": "prompt",
      "rulesEnabled": true
    },
    {
      "name": "quick-import",
      "description": "Fast import without extras - no OCR, auto-confirm, skip duplicates",
      "enableOcr": false,
      "autoConfirm": true,
      "duplicateAction": "skip",
      "rulesEnabled": false
    },
    {
      "name": "research-papers",
      "description": "Academic papers with full processing",
      "defaultProject": "+research",
      "defaultContext": "@study",
      "defaultPrivacy": "public",
      "enableOcr": true,
      "autoConfirm": false,
      "duplicateAction": "reimport",
      "rulesEnabled": true
    }
  ]
}
