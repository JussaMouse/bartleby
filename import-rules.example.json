{
  "$schema": "./import-rules-schema.json",
  "rules": [
    {
      "name": "Financial Documents",
      "description": "Auto-organize invoices, receipts, and financial docs",
      "match": {
        "filenamePattern": "(invoice|receipt|statement)",
        "fileTypes": ["document", "image", "text"]
      },
      "actions": {
        "project": "finances",
        "context": "admin",
        "tags": ["financial", "records"]
      },
      "priority": 100
    },
    {
      "name": "Travel Photos",
      "description": "Auto-organize travel photos",
      "match": {
        "filenamePattern": "(trip|travel|vacation)",
        "fileTypes": ["image"]
      },
      "actions": {
        "project": "travel-2026",
        "tags": ["travel", "photos"]
      },
      "priority": 90
    },
    {
      "name": "Work Documents",
      "description": "Work-related files to work project",
      "match": {
        "filenamePattern": "(meeting|proposal|contract|client)",
        "fileTypes": ["document", "text", "spreadsheet"]
      },
      "actions": {
        "project": "work",
        "context": "work",
        "privacy": "confidential"
      },
      "priority": 80
    },
    {
      "name": "Tax Documents",
      "description": "Tax-related documents",
      "match": {
        "filenamePattern": "(w2|1099|tax|irs)",
        "fileTypes": ["document", "spreadsheet"]
      },
      "actions": {
        "project": "taxes-2026",
        "context": "admin",
        "privacy": "confidential",
        "tags": ["tax", "important"]
      },
      "priority": 110
    },
    {
      "name": "Default Media",
      "description": "General media imports",
      "match": {
        "fileTypes": ["image", "archive"]
      },
      "actions": {
        "tags": ["imported"]
      },
      "priority": 10
    }
  ]
}
